{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerOS",
  "version": "0.1.0",
  "identifier": "com.careeros.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "CareerOS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: tauri:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "resources": ["sidecars/*"],
    "externalBin": ["sidecars/typst.exe", "sidecars/pdftoppm.exe", "sidecars/pdftotext.exe"]
  }
}
